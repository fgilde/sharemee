@using System.Globalization
@using System.Text.Json
@using Coworkee.Client.Blazor.Api
@using Shareme.Contracts.Metadata

@if (_fields is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_fields.Count == 0)
{
    <MudText Typo="Typo.body2">No properties apply here yet.</MudText>
}
else
{
    @foreach (var group in _fields.GroupBy(f => f.Group).OrderBy(g => g.Key.SortIndex))
    {
        @if (group.Key.Name is { Length: > 0 } groupName)
        {
            <MudText Typo="Typo.subtitle1" Class="mt-4">@groupName</MudText>
        }

        @foreach (var field in group)
        {
            <div class="mb-3" data-property="@field.Definition.Key">
                @switch (Editor(field.Definition))
                {
                    case "list":
                        <MudSelect T="string" Label="@field.Label" MultiSelection="@(field.Definition.ListMode == ListModes.Multi)" Clearable="true"
                                   SelectedValues="field.ListKeys" SelectedValuesChanged="values => field.ListKeys = values.ToList()" ReadOnly="field.ReadOnly"
                                   HelperText="@field.Helper" Required="field.Mandatory">
                            @foreach (var item in field.Definition.ListValues.Where(v => v.IsActive || field.ListKeys.Contains(v.Key)))
                            {
                                <MudSelectItem T="string" Value="@item.Key">@item.Name</MudSelectItem>
                            }
                        </MudSelect>
                        @if (field.Definition.AllowCustomValues)
                        {
                            <MudTextField T="string" @bind-Value="field.Text" Label="Other value" Margin="Margin.Dense" ReadOnly="field.ReadOnly" />
                        }
                        break;
                    case "boolean":
                        <MudCheckBox T="bool?" @bind-Value="field.Bool" TriState="true" Label="@field.Label" ReadOnly="field.ReadOnly" />
                        @if (field.Helper is { } hint)
                        {
                            <MudText Typo="Typo.caption">@hint</MudText>
                        }
                        break;
                    case "number":
                        <MudNumericField T="decimal?" @bind-Value="field.Number" Label="@field.Label" HelperText="@field.Helper" ReadOnly="field.ReadOnly" Required="field.Mandatory" />
                        break;
                    case "date":
                        <MudDatePicker Date="field.Date" DateChanged="d => field.Date = d" Label="@field.Label" HelperText="@field.Helper" ReadOnly="field.ReadOnly" Editable="true" />
                        break;
                    default:
                        <MudTextField T="string" @bind-Value="field.Text" Label="@field.Label" HelperText="@field.Helper" ReadOnly="field.ReadOnly" Required="field.Mandatory"
                                      Lines="@(field.Definition.ValueType is PropertyValueTypes.Text or PropertyValueTypes.RichText ? 3 : 1)"
                                      Placeholder="@Placeholder(field.Definition.ValueType)" />
                        break;
                }
                @if (_errors.TryGetValue(field.Definition.Key, out var messages))
                {
                    <MudText Typo="Typo.caption" Color="Color.Error">@string.Join(" ", messages)</MudText>
                }
            </div>
        }
    }

    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" data-testid="save-metadata">Save</MudButton>
}
