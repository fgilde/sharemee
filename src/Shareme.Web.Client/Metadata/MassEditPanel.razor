@using Coworkee.Client.Blazor.Api
@using Shareme.Contracts.Automation
@using Shareme.Contracts.Metadata
@using Shareme.Contracts.Search
@inject IMetadataApi Metadata
@inject IDataApi Api
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<MudPaper Outlined="true" Class="pa-4 mb-2" data-testid="mass-edit">
    <MudText Typo="Typo.h6">Edit metadata of @Scope</MudText>
    <MudText Typo="Typo.body2" Class="mb-2">Several values of multi valued properties are separated by "; ". Overwrite replaces all values, merge adds values (single valued properties keep other languages), delete removes the property.</MudText>
    @foreach (var row in _rows)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" data-testid="mutation">
            <MudSelect T="string" @bind-Value="row.Key" Label="Property" Style="max-width:240px">
                @foreach (var definition in _definitions)
                {
                    <MudSelectItem Value="@definition.Key">@definition.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" @bind-Value="row.Strategy" Label="Change" Style="max-width:160px">
                @foreach (var strategy in Strategies)
                {
                    <MudSelectItem Value="@strategy">@strategy</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="row.Text" Label="Value" Disabled="row.Strategy == MassEditStrategies.Delete" />
            @if (Definition(row)?.Localizable == true)
            {
                <MudSelect T="string" @bind-Value="row.Lang" Label="Language" Style="max-width:140px">
                    @foreach (var language in _languages)
                    {
                        <MudSelectItem Value="@language.Code">@language.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" aria-label="Remove change" OnClick="() => _rows.Remove(row)" />
        </MudStack>
    }
    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Outlined.Add" OnClick="() => _rows.Add(new())" data-testid="add-mutation">Property</MudButton>
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-2">
        <MudCheckBox @bind-Value="_dryRun" Label="Dry run" data-testid="mass-edit-dry-run" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartAsync" data-testid="start-mass-edit">Start</MudButton>
        <MudButton OnClick="Closed">Cancel</MudButton>
    </MudStack>
</MudPaper>

@code {
    private static readonly string[] Strategies = [MassEditStrategies.Overwrite, MassEditStrategies.Merge, MassEditStrategies.Delete];
    private IReadOnlyList<PropertyDefinitionDto> _definitions = [];
    private IReadOnlyList<DataLanguageDto> _languages = [];
    private readonly List<Row> _rows = [new()];
    private bool _dryRun;

    /// <summary>The nodes to change; otherwise every hit of <see cref="Search"/>.</summary>
    [Parameter] public IReadOnlyList<Guid>? NodeIds { get; set; }

    [Parameter] public SearchRequest? Search { get; set; }

    [Parameter] public EventCallback Closed { get; set; }

    private string Scope => NodeIds is { } ids ? $"{ids.Count} selected" : "all hits";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _definitions = (await Metadata.GetDefinitionsAsync()).Where(d => d.Editable && !d.IsSystem && !d.HasContext).ToList();
            _languages = await Metadata.GetLanguagesAsync();
        }
        catch (ApiException exception)
        {
            Snackbar.Add(exception.Message, Severity.Warning);
        }
    }

    private PropertyDefinitionDto? Definition(Row row) => _definitions.FirstOrDefault(d => d.Key == row.Key);

    private async Task StartAsync()
    {
        var mutations = _rows.Where(r => r.Key is not null).Select(r => new PropertyMutation(
            r.Key!, r.Strategy, Texts: r.Strategy == MassEditStrategies.Delete ? null : (r.Text ?? string.Empty).Split(TableColumns.Separator.Trim(), StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries),
            Lang: Definition(r)?.Localizable == true ? r.Lang ?? _languages.FirstOrDefault(l => l.IsDefault)?.Code : null)).ToList();
        try
        {
            var job = await Api.MassEditAsync(new MassEditRequest(mutations, NodeIds, NodeIds is null ? Search : null, _dryRun));
            Nav.NavigateTo($"/data-jobs/{job.Id}");
        }
        catch (ApiException exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

    private sealed class Row
    {
        public string? Key { get; set; }
        public string Strategy { get; set; } = MassEditStrategies.Overwrite;
        public string? Text { get; set; }
        public string? Lang { get; set; }
    }
}
