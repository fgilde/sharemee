@using Coworkee.Client.Blazor.Api
@using Shareme.Contracts.Automation
@using Shareme.Contracts.Metadata
@using Shareme.Contracts.Search

<MudPaper Outlined="true" Class="pa-4 mb-2" data-testid="mass-edit">
    <MudText Typo="Typo.h6">Edit metadata of @Scope</MudText>
    <MudText Typo="Typo.body2" Class="mb-2">Several values of multi valued properties are separated by "; ". Overwrite replaces the values (of the chosen language only, for properties with languages), merge adds values, delete removes them (of the chosen language only).</MudText>
    @foreach (var row in _rows)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" data-testid="mutation">
            <MudSelect T="string" @bind-Value="row.Key" Label="Property" Style="max-width:240px">
                @foreach (var definition in _definitions)
                {
                    <MudSelectItem Value="@definition.Key">@definition.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" @bind-Value="row.Strategy" Label="Change" Style="max-width:160px">
                @foreach (var strategy in Strategies)
                {
                    <MudSelectItem Value="@strategy">@strategy</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="row.Text" Label="Value" Disabled="row.Strategy == MassEditStrategies.Delete" />
            @if (Definition(row)?.Localizable == true)
            {
                <MudSelect T="string" @bind-Value="row.Lang" Label="Language" Style="max-width:140px">
                    @foreach (var language in _languages)
                    {
                        <MudSelectItem Value="@language.Code">@language.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" aria-label="Remove change" OnClick="() => _rows.Remove(row)" />
        </MudStack>
    }
    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Outlined.Add" OnClick="() => _rows.Add(new())" data-testid="add-mutation">Property</MudButton>
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-2">
        <MudCheckBox @bind-Value="_dryRun" Label="Dry run" data-testid="mass-edit-dry-run" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartAsync" data-testid="start-mass-edit">Start</MudButton>
        <MudButton OnClick="Closed">Cancel</MudButton>
    </MudStack>
</MudPaper>
