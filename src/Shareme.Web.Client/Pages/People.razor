@page "/people"
@attribute [Authorize]
@using Coworkee.Client.Blazor.Api
@using Microsoft.AspNetCore.Components.Forms
@using Shareme.Contracts.Knowledge
@using Shareme.Web.Client.Knowledge

<PageHeader Title="People" Description="Find colleagues by name, department or place. Use the profile button to fill in your own profile and picture.">
    <MudTextField Margin="Density.Margin" T="string" @bind-Value="_search" Placeholder="Name, department, place" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                  Immediate="true" DebounceInterval="300" OnDebounceIntervalElapsed="_ => LoadAsync()" Style="max-width:300px" data-testid="people-search" />
    <MudTooltip Text="@L["Edit my profile"]">
        <MudToggleIconButton @bind-Toggled="_editing" Icon="@Icons.Material.Outlined.ManageAccounts" ToggledIcon="@Icons.Material.Filled.ManageAccounts" aria-label="My profile" data-testid="edit-profile" />
    </MudTooltip>
</PageHeader>

@if (_editing)
{
    <MudPaper Outlined="true" Class="pa-4 mb-4" data-testid="profile-editor">
        <MudText Typo="Typo.h6">My profile</MudText>
        <MudGrid>
            <MudItem xs="12" sm="6"><MudTextField Margin="Density.Margin" @bind-Value="_profile.Department" Label="Department" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField Margin="Density.Margin" @bind-Value="_profile.Position" Label="Position" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField Margin="Density.Margin" @bind-Value="_profile.Phone" Label="Phone" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField Margin="Density.Margin" @bind-Value="_profile.Location" Label="Location" /></MudItem>
            <MudItem xs="12"><MudTextField Margin="Density.Margin" @bind-Value="_profile.About" Label="About me" Lines="3" /></MudItem>
        </MudGrid>
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" data-testid="save-profile">Save</MudButton>
            <MudFileUpload T="IBrowserFile" Accept=".png,.jpg,.jpeg,.webp" FilesChanged="UploadAsync">
                <CustomContent>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.AccountCircle" OnClick="context.OpenFilePickerAsync">Picture</MudButton>
                </CustomContent>
            </MudFileUpload>
            <MudButton OnClick="RemoveAvatarAsync">Remove picture</MudButton>
        </MudStack>
    </MudPaper>
}

<MudGrid Spacing="2" data-testid="people">
    @foreach (var person in _people)
    {
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudCard Outlined="true" data-person="@person.DisplayName">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        @if (person.HasAvatar)
                        {
                            <MudAvatar><MudImage Src="@IPeopleApi.AvatarUrl(person)" Alt="" /></MudAvatar>
                        }
                        else
                        {
                            <MudAvatar Color="Color.Primary">@Initials(person.DisplayName)</MudAvatar>
                        }
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudText Typo="Typo.subtitle1">@person.DisplayName</MudText>
                        <MudText Typo="Typo.caption">@person.Position @(person.Department is null ? null : $"· {person.Department}")</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="pt-0">
                    @if (person.Email is { } email) { <div>@if (IPeopleApi.MailTo(email) is { } mail) { <MudLink Href="@mail">@email</MudLink> } else { @email }</div> }
                    @if (person.Phone is { } phone) { <div>@phone</div> }
                    @if (person.Location is { } location) { <MudText Typo="Typo.caption">@location</MudText> }
                    @if (person.About is { } about) { <MudText Typo="Typo.body2" Class="mt-1" Style="white-space:pre-line">@about</MudText> }
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
    @if (_people.Count == 0)
    {
        <MudItem xs="12"><MudText Typo="Typo.body2">@L["Nobody found. Try another name, department or place."]</MudText></MudItem>
    }
</MudGrid>
@if (_people.Count > 0 && _people.Count % 50 == 0)
{
    <MudButton Class="mt-2" OnClick="MoreAsync">More</MudButton>
}
