@page "/jobs"
@attribute [Authorize]
@using Coworkee.Client.Blazor.Api
@using Shareme.Contracts.Automation
@using Shareme.Web.Client.Metadata

<PageHeader Title="My background tasks" Description="Mass edits, imports, AI tagging and rule runs you started. They run in the background; open a report to see what was changed.">
    <MudTooltip Text="@L["Refresh"]">
        <MudIconButton Icon="@Icons.Material.Outlined.Refresh" aria-label="Refresh" OnClick="LoadAsync" />
    </MudTooltip>
    @if (_overview?.DashboardUrl is { } dashboard)
    {
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Schedule" Href="@dashboard" Target="_blank" data-testid="hangfire">Background jobs</MudButton>
    }
</PageHeader>

<MudSimpleTable Dense="Density.Dense" Hover="true" data-testid="runs">
    <thead><tr><th>Started</th><th>@L["Task"]</th><th>State</th><th>Total</th><th>Done</th><th>Failed</th><th></th></tr></thead>
    <tbody>
        @foreach (var run in _overview?.Runs ?? [])
        {
            <tr data-kind="@run.Kind">
                <td>@run.CreatedAt.ToLocalTime().ToString("g")</td>
                <td>@Kind(run.Kind)</td>
                <td>@run.State @run.Error</td>
                <td>@run.Total</td>
                <td>@run.Done</td>
                <td>@run.Failed</td>
                <td style="text-align:right"><MudLink Href="@run.Link">Report</MudLink></td>
            </tr>
        }
        @if (_overview is { Runs.Count: 0 })
        {
            <tr><td colspan="7">@L["No background tasks yet. They appear when you edit the metadata of many files, import a file or start AI tagging in Browse."]</td></tr>
        }
    </tbody>
</MudSimpleTable>
