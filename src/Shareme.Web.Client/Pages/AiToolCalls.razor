@page "/admin/ai-tool-calls"
@attribute [Authorize]
@using Coworkee.Client.Blazor.Api
@using Coworkee.Contracts.Ai
@using Shareme.Web.Client.Assistant

<PageTitle>AI tool calls</PageTitle>
<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">AI tool calls</MudText>
    <MudSpacer />
    <MudTextField T="string" @bind-Value="_search" Placeholder="Tool" Immediate="false" OnBlur="ReloadAsync" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" Style="max-width:240px" />
    <MudIconButton Icon="@Icons.Material.Outlined.Refresh" aria-label="Refresh" OnClick="ReloadAsync" />
</MudStack>

<MudSimpleTable Dense="true" Hover="true" data-testid="tool-calls">
    <thead><tr><th>When</th><th>Channel</th><th>Tool</th><th>User</th><th>Input</th><th>Result</th><th>ms</th></tr></thead>
    <tbody>
        @foreach (var call in _page?.Items ?? [])
        {
            <tr data-tool="@call.Tool">
                <td>@call.At.ToLocalTime().ToString("g")</td>
                <td>@call.Channel</td>
                <td>@call.Tool</td>
                <td>@call.UserId</td>
                <td style="max-width:420px;overflow-wrap:anywhere"><code>@call.Input</code></td>
                <td>@(call.Succeeded ? "OK" : call.Error)</td>
                <td>@call.DurationMs</td>
            </tr>
        }
    </tbody>
</MudSimpleTable>
@if (_page is { } loaded && loaded.TotalCount > PageSize)
{
    <MudPagination Count="@((loaded.TotalCount + PageSize - 1) / PageSize)" Selected="_pageNumber" SelectedChanged="PageAsync" Class="mt-2" />
}
