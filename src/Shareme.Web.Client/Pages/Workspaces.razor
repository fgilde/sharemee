@page "/workspaces"
@attribute [Authorize]
@using Coworkee.Client.Blazor.Api
@using Shareme.Contracts.Workspaces
@using Shareme.Web.Client.Workspaces
@inject IWorkspacesApi Api
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Workspaces</PageTitle>
<MudText Typo="Typo.h4" Class="mb-4">Workspaces</MudText>

<MudTabs Elevation="0" Outlined="true" ActivePanelIndexChanged="TabAsync">
    <MudTabPanel Text="My workspaces" />
    <PermissionView Permission="@WorkspacePermissions.ManageTemplates">
        <MudTabPanel Text="Templates" data-testid="templates-tab" />
    </PermissionView>
</MudTabs>

<MudGrid Class="mt-4" data-testid="workspaces">
    @foreach (var workspace in _workspaces)
    {
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudCard Outlined="true" Style="cursor:pointer" @onclick="@(() => Nav.NavigateTo($"/workspaces/{workspace.Id}"))" data-workspace="@workspace.Name">
                <MudCardContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icon(workspace.Kind)" />
                        <MudText Typo="Typo.h6">@workspace.Name</MudText>
                    </MudStack>
                    <MudStack Row="true" Class="mt-2" Spacing="1">
                        <MudChip T="string" Size="Size.Small">@workspace.Kind</MudChip>
                        @if (workspace.MyRole is { } role)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">@role</MudChip>
                        }
                        @if (workspace.FinalizedAt is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success">finalised</MudChip>
                        }
                    </MudStack>
                    <MudText Typo="Typo.caption">@workspace.ItemCount items · @workspace.CreatedAt.ToLocalTime().ToString("d")</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
    @if (_workspaces.Count == 0)
    {
        <MudItem xs="12"><MudText Typo="Typo.body2">@(_templates ? "No templates yet." : "You are not a member of any workspace yet.")</MudText></MudItem>
    }
</MudGrid>

<PermissionView Permission="@(_templates ? WorkspacePermissions.ManageTemplates : WorkspacePermissions.Create)">
    <MudPaper Outlined="true" Class="pa-4 mt-6">
        <MudText Typo="Typo.h6">@(_templates ? "New template" : "New workspace")</MudText>
        <MudStack Row="true" AlignItems="AlignItems.End" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="_name" Label="Name" data-testid="workspace-name" />
            @if (!_templates && _available.Count > 0)
            {
                <MudSelect T="Guid?" @bind-Value="_templateId" Label="From template" Clearable="true" Style="min-width:220px" data-testid="workspace-template">
                    @foreach (var template in _available)
                    {
                        <MudSelectItem T="Guid?" Value="@template.Id">@template.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            @if (_templateId is null)
            {
                <MudSelect T="string" @bind-Value="_kind" Label="Kind" Style="min-width:180px">
                    @foreach (var kind in WorkspaceKinds.All)
                    {
                        <MudSelectItem Value="@kind">@kind</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="string.IsNullOrWhiteSpace(_name)" OnClick="CreateAsync" data-testid="create-workspace">Create</MudButton>
        </MudStack>
    </MudPaper>
</PermissionView>

@code {
    private IReadOnlyList<WorkspaceDto> _workspaces = [];
    private IReadOnlyList<WorkspaceDto> _available = [];
    private bool _templates;
    private string? _name;
    private string _kind = WorkspaceKinds.Collaboration;
    private Guid? _templateId;

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task TabAsync(int index)
    {
        _templates = index == 1;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _workspaces = await Api.GetAsync(_templates);
            _available = _templates ? [] : await Api.GetAsync(templates: true);
        }
        catch (ApiException exception)
        {
            Snackbar.Add(exception.Message, Severity.Warning);
        }
    }

    private async Task CreateAsync()
    {
        try
        {
            var created = await Api.CreateAsync(new CreateWorkspaceRequest(_name!, _kind, _templateId, _templates));
            Nav.NavigateTo($"/workspaces/{created.Id}");
        }
        catch (ApiException exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

    internal static string Icon(string kind) => kind switch
    {
        WorkspaceKinds.Upload => Icons.Material.Outlined.CloudUpload,
        WorkspaceKinds.Collection => Icons.Material.Outlined.CollectionsBookmark,
        _ => Icons.Material.Outlined.Groups,
    };
}
