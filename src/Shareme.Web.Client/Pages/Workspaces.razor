@page "/workspaces"
@attribute [Authorize]
@using Coworkee.Client.Blazor.Api
@using Shareme.Contracts.Workspaces
@using Shareme.Web.Client.Workspaces

<PageHeader Title="Workspaces" Description="Shared spaces to upload, collect and work on files together. Create one below, add members, and finalise it into a folder when the work is done." />

<MudTabs Elevation="0" Outlined="true" ActivePanelIndexChanged="TabAsync">
    <MudTabPanel Text="My workspaces" />
    <PermissionView Permission="@WorkspacePermissions.ManageTemplates">
        <MudTabPanel Text="Templates" data-testid="templates-tab" />
    </PermissionView>
</MudTabs>

<MudGrid Class="mt-4" data-testid="workspaces">
    @foreach (var workspace in _workspaces)
    {
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudCard Outlined="true" Style="@(workspace.MyRole is null ? null : "cursor:pointer")" @onclick="@(() => Open(workspace))" data-workspace="@workspace.Name">
                <MudCardContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icon(workspace.Kind)" />
                        <MudText Typo="Typo.h6">@workspace.Name</MudText>
                    </MudStack>
                    <MudStack Row="true" Class="mt-2" Spacing="1">
                        <MudChip T="string" Size="Size.Small">@L[KindName(workspace.Kind)]</MudChip>
                        @if (workspace.MyRole is { } role)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">@L[RoleName(role)]</MudChip>
                        }
                        @if (workspace.FinalizedAt is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success">@L["Finalised"]</MudChip>
                        }
                    </MudStack>
                    <MudText Typo="Typo.caption">@workspace.ItemCount items · @workspace.CreatedAt.ToLocalTime().ToString("d")</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
    @if (_workspaces.Count == 0)
    {
        <MudItem xs="12"><MudText Typo="Typo.body2">@(_templates ? L["No templates yet. Create one below; new workspaces can then start from it."] : L["You are not a member of any workspace yet. Ask a colleague to add you, or create a new one below."])</MudText></MudItem>
    }
</MudGrid>

<PermissionView Permission="@(_templates ? WorkspacePermissions.ManageTemplates : WorkspacePermissions.Create)">
    <MudPaper Outlined="true" Class="pa-4 mt-6">
        <MudText Typo="Typo.h6">@(_templates ? "New template" : "New workspace")</MudText>
        <MudStack Row="true" AlignItems="AlignItems.End" Wrap="Wrap.Wrap">
            <MudTextField Margin="Density.Margin" @bind-Value="_name" Label="Name" data-testid="workspace-name" />
            @if (!_templates && _available.Count > 0)
            {
                <MudSelect Margin="Density.Margin" Dense="Density.Dense" T="Guid?" @bind-Value="_templateId" Label="From template" Clearable="true" Style="min-width:220px" data-testid="workspace-template">
                    @foreach (var template in _available)
                    {
                        <MudSelectItem T="Guid?" Value="@template.Id">@template.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            @if (_templateId is null)
            {
                <MudSelect Margin="Density.Margin" Dense="Density.Dense" T="string" @bind-Value="_kind" Label="@L["Kind"]" HelperText="@L[KindHelp(_kind)]" Style="min-width:260px;max-width:360px">
                    @foreach (var kind in WorkspaceKinds.All)
                    {
                        <MudSelectItem Value="@kind">@L[KindName(kind)]</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="string.IsNullOrWhiteSpace(_name)" OnClick="CreateAsync" data-testid="create-workspace">Create</MudButton>
        </MudStack>
    </MudPaper>
</PermissionView>
