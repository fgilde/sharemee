@page "/workspaces/{Id:guid}"
@attribute [Authorize]
@using Coworkee.Client.Blazor.Api
@using Shareme.Contracts.Graph
@using Shareme.Contracts.Workspaces
@using Shareme.Web.Client.Assets
@using Shareme.Web.Client.Workspaces

<PageTitle>@(_workspace?.Name ?? "Workspace")</PageTitle>

@if (_workspace is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <RealtimeSubscription @key="_workspace.Id" Topic="@($"children:{_workspace.Id}")" OnEvent="_ => LoadAsync()" />
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudTooltip Text="@L["Back to workspaces"]">
            <MudIconButton Icon="@Icons.Material.Outlined.ArrowBack" Href="/workspaces" aria-label="Back to workspaces" />
        </MudTooltip>
        <MudIcon Icon="@Workspaces.Icon(_workspace.Kind)" />
        <MudText Typo="Typo.h4" data-testid="workspace-title">@_workspace.Name</MudText>
        <MudChip T="string" Size="Size.Small">@L[Workspaces.KindName(_workspace.Kind)]</MudChip>
        @if (_workspace.IsTemplate)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@L["Template"]</MudChip>
        }
        @if (_workspace.FinalizedAt is { } finalized)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Success">@L["Finalised"] @finalized.ToLocalTime().ToString("d")</MudChip>
        }
        <MudSpacer />
        <MudTooltip Text="@(_subscribed ? "Stop notifications" : "Notify me about changes")">
            <MudIconButton Icon="@(_subscribed ? Icons.Material.Filled.NotificationsActive : Icons.Material.Outlined.NotificationsNone)" OnClick="ToggleWatchAsync" aria-label="Watch this workspace" data-testid="watch" />
        </MudTooltip>
        @if (_workspace is { CanFinalize: true, IsTemplate: false, FinalizedAt: null } && _workspace.Kind != WorkspaceKinds.Collection)
        {
            <MudTooltip Text="@L[FinalizeHelp]">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.TaskAlt" OnClick="FinalizeAsync" data-testid="finalize">@L["Finalise"]</MudButton>
            </MudTooltip>
        }
    </MudStack>

    <MudTabs Elevation="0" Outlined="true">
        @if (_workspace.Kind == WorkspaceKinds.Collaboration && !_workspace.IsTemplate)
        {
            <MudTabPanel Text="Board">
                <div class="pa-4"><TaskBoard WorkspaceId="_workspace.Id" Members="_members" IsOwner="IsOwner" /></div>
            </MudTabPanel>
        }
        <MudTabPanel Text="Items">
            <div class="pa-4">
                @if (_workspace is { IsTemplate: false, FinalizedAt: null } && _workspace.Kind != WorkspaceKinds.Collection)
                {
                    <div class="mb-4"><UploadPanel FolderId="_workspace.Id" /></div>
                }
                <MudSimpleTable Dense="true" Hover="true" data-testid="items">
                    <thead><tr><th></th><th>Name</th><th>Type</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var item in _items)
                        {
                            <tr data-item="@item.Node.Name">
                                <td style="width:56px">
                                    @if (item.Node.Thumbnail is { } tag)
                                    {
                                        <img src="@AssetUrls.Derivation(item.Node.Id, Shareme.Contracts.Assets.DerivationKinds.Thumbnail, tag)" alt="" style="max-width:48px;max-height:48px" />
                                    }
                                </td>
                                <td><MudLink Href="@(item.Node.Semantic switch { "asset" => $"/assets/{item.Node.Id}", "page" => $"/pages/{item.Node.Id}", _ => $"/browse/{item.Node.Id}" })">@item.Node.Name</MudLink></td>
                                <td>@L[item.IsLinked ? "Linked" : TypeName(item.Node.Semantic)]</td>
                                <td style="text-align:right">
                                    @if (item.IsLinked)
                                    {
                                        <MudTooltip Text="@L["Remove from this workspace"]">
                                            <MudIconButton Icon="@Icons.Material.Outlined.LinkOff" Size="Size.Small" aria-label="Remove link" OnClick="() => RunAsync(() => Api.UnlinkAsync(_workspace.Id, item.Node.Id))" />
                                        </MudTooltip>
                                    }
                                </td>
                            </tr>
                        }
                        @if (_items.Count == 0)
                        {
                            <tr><td colspan="4">@L["Nothing here yet. Upload files above, or select files in Browse and choose Add to collection."]</td></tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
        </MudTabPanel>
        <MudTabPanel Text="Members">
            <div class="pa-4">
                <MudSimpleTable Dense="true" data-testid="members">
                    <tbody>
                        @foreach (var member in _members)
                        {
                            <tr data-member="@member.Email">
                                <td>@(string.IsNullOrWhiteSpace(member.Name) ? member.Email : $"{member.Name} ({member.Email})")</td>
                                <td>@L[Workspaces.RoleName(member.Role)]</td>
                                <td style="text-align:right">
                                    @if (IsOwner)
                                    {
                                        <MudTooltip Text="@L["Remove member"]">
                                            <MudIconButton Icon="@Icons.Material.Outlined.PersonRemove" Size="Size.Small" aria-label="Remove member" OnClick="() => RunAsync(() => Api.RemoveMemberAsync(_workspace.Id, member.UserId))" />
                                        </MudTooltip>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
                @if (IsOwner)
                {
                    <MudStack Row="true" AlignItems="AlignItems.End" Class="mt-4">
                        <MudAutocomplete T="WorkspaceMemberDto" @bind-Value="_candidate" SearchFunc="FindAsync" ToStringFunc="@(m => m is null ? null : m.Email)" Label="Add a member" DebounceInterval="300" Style="min-width:280px" data-testid="member-search" />
                        <MudSelect T="string" @bind-Value="_role" Label="Role" Style="max-width:160px">
                            @foreach (var role in WorkspaceRoles.All)
                            {
                                <MudSelectItem Value="@role">@L[Workspaces.RoleName(role)]</MudSelectItem>
                            }
                        </MudSelect>
                        <MudButton Variant="Variant.Filled" Disabled="_candidate is null" OnClick="AddMemberAsync" data-testid="add-member">Add</MudButton>
                    </MudStack>
                }
            </div>
        </MudTabPanel>
        <MudTabPanel Text="Comments">
            <div class="pa-4"><CommentsPanel NodeId="_workspace.Id" Members="_members" /></div>
        </MudTabPanel>
        <MudTabPanel Text="Metadata">
            <div class="pa-4"><Shareme.Web.Client.Metadata.MetadataEditor @key="_workspace.Id" NodeId="_workspace.Id" /></div>
        </MudTabPanel>
        @if (IsOwner)
        {
            <MudTabPanel Text="@L["Settings"]">
                <div class="pa-4">
                    <MudTextField @bind-Value="_name" Label="Name" />
                    @if (_workspace.Kind != WorkspaceKinds.Collection)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mt-4">Finalise into</MudText>
                        <MudText Typo="Typo.caption" Class="d-block">@L[FinalizeHelp]</MudText>
                        <MudText Typo="Typo.body2">@(_folderName ?? L["No folder chosen"])</MudText>
                        @if (_rootId is { } root)
                        {
                            <Shareme.Web.Client.Graph.FolderPicker StartId="root" OnPicked="PickFolderAsync" />
                        }
                        <MudSwitch T="bool" @bind-Value="_copyMetadata" Color="Color.Primary" Label="Copy the workspace's metadata to the files when finalising" />
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" OnClick="SaveAsync" data-testid="save-settings">Save</MudButton>
                </div>
            </MudTabPanel>
        }
        @if (IsOwner && !_workspace.IsTemplate)
        {
            <MudTabPanel Text="@L["Share links"]">
                <div class="pa-4"><SharesPanel WorkspaceId="_workspace.Id" /></div>
            </MudTabPanel>
        }
        <MudTabPanel Text="Activity">
            <div class="pa-4"><AuditTimeline EntityType="Workspace" EntityId="@_workspace.Id.ToString()" /></div>
        </MudTabPanel>
    </MudTabs>
}
