@page "/purchases"
@attribute [Authorize]
@using Coworkee.Client.Blazor.Api
@using Shareme.Contracts.Drm
@using Shareme.Web.Client.Drm

<PageHeader Title="My purchases" Description="Licenses you have bought, with the period they are valid and how many files they cover. Buy more in the License shop." />

<MudSimpleTable Dense="true" Hover="true" data-testid="purchases">
    <thead><tr><th>Order</th><th>License</th><th>For</th><th>From</th><th>Until</th><th>Files</th><th>Price</th></tr></thead>
    <tbody>
        @foreach (var purchase in _purchases)
        {
            <tr data-order="@purchase.OrderId">
                <td>@purchase.OrderId</td>
                <td>@purchase.LicenseName</td>
                <td>@(purchase.TargetName ?? purchase.ContextKey)</td>
                <td>@purchase.StartsOn</td>
                <td>@purchase.EndsOn</td>
                <td>@purchase.AssetIds.Count</td>
                <td>@Licenses.Format(purchase.Prices)</td>
            </tr>
        }
        @if (_purchases.Count == 0)
        {
            <tr><td colspan="7">@L["No purchases yet. Licenses you buy in the License shop show up here."]</td></tr>
        }
    </tbody>
</MudSimpleTable>
