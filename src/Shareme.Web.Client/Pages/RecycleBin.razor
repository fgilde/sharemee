@page "/recycle-bin"
@attribute [Authorize]
@using Coworkee.Client.Blazor.Api
@using Coworkee.Contracts
@using Shareme.Contracts.Graph
@using Shareme.Web.Client.Graph

<PageHeader Title="Recycle bin" Description="Deleted folders, files and pages stay here until they are deleted for good. Restore puts an item back where it was." />
<MudSimpleTable Dense="Density.Dense" Hover="true">
    <thead><tr><th>Name</th><th>Type</th><th>Deleted</th><th></th></tr></thead>
    <tbody>
        @foreach (var item in _items)
        {
            <tr data-item="@item.Id">
                <td>@item.Name</td>
                <td>@item.Type</td>
                <td>@item.DeletedAt?.ToLocalTime().ToString("g")</td>
                <td style="text-align:right">
                    <MudButton Size="Size.Small" OnClick="() => RunAsync(() => Api.RestoreAsync(item.Id))" data-testid="@($"restore-{item.Id}")">Restore</MudButton>
                    <PermissionView Permission="@NodePermissions.Admin">
                        <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => RunAsync(() => Api.PurgeAsync(item.Id))" data-testid="@($"purge-{item.Id}")">Delete for good</MudButton>
                    </PermissionView>
                </td>
            </tr>
        }
        @if (_items.Count == 0)
        {
            <tr><td colspan="4">@L["The recycle bin is empty. Items you delete in Browse land here."]</td></tr>
        }
    </tbody>
</MudSimpleTable>
