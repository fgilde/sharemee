@page "/admin/drm"
@attribute [Authorize]
@using Coworkee.Client.Blazor.Api
@using Shareme.Contracts.Drm
@using Shareme.Web.Client.Drm

<PageHeader Title="License management" Description="Set up the licenses people can buy for files: who owns the rights, what they cost and for whom." />
<MudAlert Severity="Severity.Info" Dense="Density.Dense" Class="mb-4" data-testid="setup-order">@L["Setup order: 1. Billing contacts 2. Rights owners 3. Audience groups (optional) 4. Price lists 5. Licenses with a price per rights owner 6. Add files: select them in Browse and choose Add to license."]</MudAlert>

<MudTabs Outlined="true">
    <MudTabPanel Text="Licenses">
        <MudSimpleTable Dense="Density.Dense" Hover="true" data-testid="licenses">
            <thead><tr><th>Name</th><th>Status</th><th>Rights</th><th>Period</th><th>Days</th><th>Files</th><th></th></tr></thead>
            <tbody>
                @foreach (var license in _licenses)
                {
                    <tr data-license="@license.Name">
                        <td>@license.Name</td>
                        <td>@license.Status</td>
                        <td>@string.Join(", ", license.Rights)</td>
                        <td>@license.ValidFrom – @license.ValidUntil</td>
                        <td>@license.PurchaseDays</td>
                        <td>@license.AssetCount</td>
                        <td style="text-align:right">
                            <MudTooltip Text="@L["Edit"]"><MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" aria-label="Edit" OnClick="() => EditLicenseAsync(license)" /></MudTooltip>
                            <MudTooltip Text="@L["Delete"]"><MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" aria-label="Delete" OnClick="() => RunAsync(() => Api.DeleteAsync(License, license.Id))" /></MudTooltip>
                        </td>
                    </tr>
                }
                @if (_licenses.Count == 0)
                {
                    <tr><td colspan="7">@L["No licenses yet. Set up billing contacts, rights owners and price lists first, then create a license below."]</td></tr>
                }
            </tbody>
        </MudSimpleTable>
        <MudPaper Outlined="true" Class="pa-4 mt-4">
            <MudText Typo="Typo.h6">@(_licenseId is null ? "New license" : "Edit license")</MudText>
            <MudGrid>
                <MudItem xs="12" sm="4"><MudTextField Margin="Density.Margin" @bind-Value="_license.Name" Label="Name" data-testid="license-name" /></MudItem>
                <MudItem xs="12" sm="8"><MudTextField Margin="Density.Margin" @bind-Value="_license.Description" Label="Description" /></MudItem>
                <MudItem xs="12" sm="4"><MudTextField Margin="Density.Margin" @bind-Value="_license.Rights" Label="Rights (comma separated)" /></MudItem>
                <MudItem xs="6" sm="2"><MudDatePicker Margin="Density.Margin" @bind-Date="_license.From" Label="Valid from" /></MudItem>
                <MudItem xs="6" sm="2"><MudDatePicker Margin="Density.Margin" @bind-Date="_license.Until" Label="Valid until" /></MudItem>
                <MudItem xs="6" sm="2"><MudNumericField Margin="Density.Margin" @bind-Value="_license.Days" Label="@L["Days of use per purchase"]" Min="1" /></MudItem>
                <MudItem xs="6" sm="2">
                    <MudSelect Margin="Density.Margin" Dense="Density.Dense" T="string" @bind-Value="_license.Status" Label="Status">
                        @foreach (var status in LicenseStatuses.All)
                        {
                            <MudSelectItem Value="@status">@status</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
            <MudStack Row="true" Class="mt-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveLicenseAsync" data-testid="save-license">Save</MudButton>
                @if (_licenseId is not null)
                {
                    <MudButton OnClick="() => { _licenseId = null; _license = new(); _buyouts = []; }">Cancel</MudButton>
                }
            </MudStack>

            @if (_licenseId is { } licenseId)
            {
                <MudText Typo="Typo.subtitle1" Class="mt-4">@L["Prices per rights owner"]</MudText>
                <MudText Typo="Typo.body2">@L["Price = basis × (1 + fee %) × the percentage of the price list for the audience or audience group. Files are added from the selection in Browse."]</MudText>
                <MudSimpleTable Dense="Density.Dense" data-testid="buyouts">
                    <thead><tr><th>Rights owner</th><th>Price list</th><th>Basis</th><th>Fee</th><th>Valid</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var buyout in _buyouts)
                        {
                            <tr>
                                <td>@_owners.FirstOrDefault(o => o.Id == buyout.RightsOwnerId)?.Name</td>
                                <td>@_priceLists.FirstOrDefault(p => p.Id == buyout.PriceListId)?.Name</td>
                                <td>@buyout.Basis.ToString("N2") @buyout.Currency</td>
                                <td>@buyout.FeePercentage %</td>
                                <td>@buyout.ValidFrom – @buyout.ValidUntil</td>
                                <td style="text-align:right"><MudTooltip Text="@L["Delete price"]"><MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" aria-label="Delete buyout" OnClick="() => RunAsync(() => Api.DeleteBuyoutAsync(licenseId, buyout.Id))" /></MudTooltip></td>
                            </tr>
                        }
                        @if (_buyouts.Count == 0)
                        {
                            <tr><td colspan="6">@L["No prices yet. Add one per rights owner below."]</td></tr>
                        }
                    </tbody>
                </MudSimpleTable>
                <MudGrid Class="mt-2">
                    <MudItem xs="12" sm="3">
                        <MudSelect Margin="Density.Margin" Dense="Density.Dense" T="Guid?" @bind-Value="_buyout.OwnerId" Label="Rights owner">
                            @foreach (var owner in _owners)
                            {
                                <MudSelectItem T="Guid?" Value="owner.Id">@owner.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudSelect Margin="Density.Margin" Dense="Density.Dense" T="Guid?" @bind-Value="_buyout.PriceListId" Label="Price list">
                            @foreach (var list in _priceLists)
                            {
                                <MudSelectItem T="Guid?" Value="list.Id">@list.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="4" sm="2"><MudNumericField Margin="Density.Margin" @bind-Value="_buyout.Basis" Label="Basis" Min="0" /></MudItem>
                    <MudItem xs="4" sm="1"><MudTextField Margin="Density.Margin" @bind-Value="_buyout.Currency" Label="Currency" MaxLength="3" /></MudItem>
                    <MudItem xs="4" sm="1"><MudNumericField Margin="Density.Margin" @bind-Value="_buyout.Fee" Label="Fee %" Min="0" /></MudItem>
                    <MudItem xs="12" sm="2"><MudButton Variant="Variant.Outlined" OnClick="() => AddBuyoutAsync(licenseId)" Disabled="_buyout.OwnerId is null || _buyout.PriceListId is null">@L["Add price"]</MudButton></MudItem>
                </MudGrid>
            }
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="Rights owners">
        <MudSimpleTable Dense="Density.Dense" Hover="true">
            <thead><tr><th>Name</th><th>Kind</th><th>Billing contact</th><th>Active</th><th></th></tr></thead>
            <tbody>
                @foreach (var owner in _owners)
                {
                    <tr>
                        <td>@owner.Name</td>
                        <td>@owner.Kind</td>
                        <td>@_contacts.FirstOrDefault(c => c.Id == owner.BillingContactId)?.Name</td>
                        <td>@(owner.IsActive ? "yes" : "no")</td>
                        <td style="text-align:right"><MudTooltip Text="@L["Delete"]"><MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" aria-label="Delete" OnClick="() => RunAsync(() => Api.DeleteAsync(Owners, owner.Id))" /></MudTooltip></td>
                    </tr>
                }
                @if (_owners.Count == 0)
                {
                    <tr><td colspan="5">@L["No rights owners yet. Add the people or agencies that own the rights to your files."]</td></tr>
                }
            </tbody>
        </MudSimpleTable>
        <MudStack Row="true" AlignItems="AlignItems.End" Class="mt-2">
            <MudTextField Margin="Density.Margin" @bind-Value="_ownerName" Label="Name" />
            <MudTextField Margin="Density.Margin" @bind-Value="_ownerKind" Label="Kind" />
            <MudSelect Margin="Density.Margin" Dense="Density.Dense" T="Guid?" @bind-Value="_ownerContact" Label="Billing contact" Clearable="true">
                @foreach (var contact in _contacts)
                {
                    <MudSelectItem T="Guid?" Value="contact.Id">@contact.Name</MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Outlined" OnClick="() => RunAsync(() => Api.SaveOwnerAsync(null, new RightsOwnerRequest(_ownerName ?? string.Empty, _ownerKind, _ownerContact)))">Add</MudButton>
        </MudStack>
    </MudTabPanel>

    <MudTabPanel Text="Billing contacts">
        <MudSimpleTable Dense="Density.Dense" Hover="true">
            <thead><tr><th>Name</th><th>E-mail</th><th>IBAN</th><th></th></tr></thead>
            <tbody>
                @foreach (var contact in _contacts)
                {
                    <tr>
                        <td>@contact.Name</td>
                        <td>@contact.Email</td>
                        <td>@contact.Iban</td>
                        <td style="text-align:right"><MudTooltip Text="@L["Delete"]"><MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" aria-label="Delete" OnClick="() => RunAsync(() => Api.DeleteAsync(Contacts, contact.Id))" /></MudTooltip></td>
                    </tr>
                }
                @if (_contacts.Count == 0)
                {
                    <tr><td colspan="4">@L["No billing contacts yet. Start here: rights owners are paid through them."]</td></tr>
                }
            </tbody>
        </MudSimpleTable>
        <MudStack Row="true" AlignItems="AlignItems.End" Class="mt-2">
            <MudTextField Margin="Density.Margin" @bind-Value="_contactName" Label="Name" />
            <MudTextField Margin="Density.Margin" @bind-Value="_contactEmail" Label="E-mail" />
            <MudTextField Margin="Density.Margin" @bind-Value="_contactIban" Label="IBAN" />
            <MudButton Variant="Variant.Outlined" OnClick="() => RunAsync(() => Api.SaveContactAsync(null, new BillingContactRequest(_contactName ?? string.Empty, _contactEmail ?? string.Empty, Iban: _contactIban)))">Add</MudButton>
        </MudStack>
    </MudTabPanel>

    <MudTabPanel Text="Price lists">
        <MudSimpleTable Dense="Density.Dense" Hover="true">
            <thead><tr><th>Name</th><th>Percentages</th><th></th></tr></thead>
            <tbody>
                @foreach (var list in _priceLists)
                {
                    <tr>
                        <td>@list.Name</td>
                        <td>@string.Join(", ", list.Entries.Select(e => $"{e.ContextKey ?? _groups.FirstOrDefault(g => g.Id == e.GroupId)?.Name} {e.Percentage} %"))</td>
                        <td style="text-align:right"><MudTooltip Text="@L["Delete"]"><MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" aria-label="Delete" OnClick="() => RunAsync(() => Api.DeleteAsync(PriceLists, list.Id))" /></MudTooltip></td>
                    </tr>
                }
                @if (_priceLists.Count == 0)
                {
                    <tr><td colspan="3">@L["No price lists yet. A price list sets the percentage of the base price per audience or audience group."]</td></tr>
                }
            </tbody>
        </MudSimpleTable>
        <MudStack Row="true" AlignItems="AlignItems.End" Class="mt-2">
            <MudTextField Margin="Density.Margin" @bind-Value="_priceListName" Label="Name" />
            <MudTextField Margin="Density.Margin" @bind-Value="_priceListEntries" Label="@L["Percentages (audience=120, group name=80; one per line)"]" Lines="3" />
            <MudButton Variant="Variant.Outlined" OnClick="AddPriceListAsync">Add</MudButton>
        </MudStack>
    </MudTabPanel>

    <MudTabPanel Text="@L["Audience groups"]">
        <MudSimpleTable Dense="Density.Dense" Hover="true">
            <thead><tr><th>Name</th><th>@L["Audiences"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var group in _groups)
                {
                    <tr>
                        <td>@group.Name</td>
                        <td>@string.Join(", ", group.ContextKeys)</td>
                        <td style="text-align:right"><MudTooltip Text="@L["Delete"]"><MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" aria-label="Delete" OnClick="() => RunAsync(() => Api.DeleteAsync(Groups, group.Id))" /></MudTooltip></td>
                    </tr>
                }
                @if (_groups.Count == 0)
                {
                    <tr><td colspan="3">@L["No audience groups yet. They are optional and bundle audiences that share a price."]</td></tr>
                }
            </tbody>
        </MudSimpleTable>
        <MudStack Row="true" AlignItems="AlignItems.End" Class="mt-2">
            <MudTextField Margin="Density.Margin" @bind-Value="_groupName" Label="Name" />
            <MudTextField Margin="Density.Margin" @bind-Value="_groupContexts" Label="@L["Audience keys (comma separated)"]" />
            <MudButton Variant="Variant.Outlined" OnClick="() => RunAsync(() => Api.SaveGroupAsync(null, new ContextGroupRequest(_groupName ?? string.Empty, Split(_groupContexts))))">Add</MudButton>
        </MudStack>
    </MudTabPanel>
</MudTabs>
