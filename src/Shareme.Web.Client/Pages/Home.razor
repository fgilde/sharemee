@page "/"
@using Coworkee.Client.Blazor.Api
@using Shareme.Contracts.Graph
@using Shareme.Contracts.Knowledge
@using Shareme.Web.Client.Knowledge

<PageTitle>Sharemee</PageTitle>

<AuthorizeView>
    <NotAuthorized>
        <MudText Typo="Typo.h3">Sharemee</MudText>
        <MudText Class="mt-2">Assets, documents, knowledge and intranet. Sign in to start.</MudText>
    </NotAuthorized>
    <Authorized>
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
            <MudText Typo="Typo.h4">Welcome</MudText>
            <MudSpacer />
            <MudToggleIconButton @bind-Toggled="_customizing" Icon="@Icons.Material.Outlined.Dashboard" ToggledIcon="@Icons.Material.Filled.Dashboard" aria-label="Customize the start page" data-testid="customize-home" />
        </MudStack>

        @if (_customizing)
        {
            <MudPaper Outlined="true" Class="pa-4 mb-4" data-testid="home-layout">
                @foreach (var widget in HomeWidgets.All)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudCheckBox T="bool" Value="_widgets.Contains(widget)" ValueChanged="on => Toggle(widget, on)" Label="@Title(widget)" />
                        @if (_widgets.Contains(widget))
                        {
                            <MudIconButton Icon="@Icons.Material.Outlined.ArrowUpward" Size="Size.Small" aria-label="Move up" OnClick="() => Move(widget, -1)" />
                            <MudIconButton Icon="@Icons.Material.Outlined.ArrowDownward" Size="Size.Small" aria-label="Move down" OnClick="() => Move(widget, 1)" />
                        }
                    </MudStack>
                }
                <MudStack Row="true" Class="mt-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => SaveAsync(false)" data-testid="save-layout">Save</MudButton>
                    <MudButton OnClick="ResetAsync">Back to the default</MudButton>
                    <MudButton OnClick="() => SaveAsync(true)">Use as default for everyone</MudButton>
                </MudStack>
            </MudPaper>
        }

        <MudGrid>
            @foreach (var widget in _widgets)
            {
                <MudItem xs="12" md="@(widget == HomeWidgets.Search ? 12 : 6)">
                    <MudPaper Outlined="true" Class="pa-4" Style="height:100%" data-widget="@widget">
                        <MudText Typo="Typo.h6" Class="mb-2">@Title(widget)</MudText>
                        @switch (widget)
                        {
                            case HomeWidgets.Search:
                                <MudTextField T="string" @bind-Value="_term" Placeholder="Search everything" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                                              OnKeyDown="SearchKeyAsync" Immediate="true" />
                                break;
                            case HomeWidgets.News:
                                @foreach (var news in _news)
                                {
                                    <div class="mb-3">
                                        <MudLink Href="@($"/news/{news.Id}")"><b>@news.Title</b></MudLink>
                                        @if (news.Pinned)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.PushPin" Size="Size.Small" Class="ml-1" />
                                        }
                                        <MudText Typo="Typo.caption" Class="d-block">@news.PublishAt.ToLocalTime().ToString("d")</MudText>
                                        <MudText Typo="Typo.body2">@news.Teaser</MudText>
                                    </div>
                                }
                                @if (_news.Count == 0) { <MudText Typo="Typo.body2">No news.</MudText> }
                                break;
                            case HomeWidgets.Favorites:
                                <NodeList Nodes="_favorites" Empty="Mark folders, files and pages with the star to find them here." />
                                break;
                            case HomeWidgets.Recent:
                                <NodeList Nodes="_recent" Empty="Nothing changed lately." />
                                break;
                            case HomeWidgets.Tasks:
                            case HomeWidgets.Due:
                                var tasks = widget == HomeWidgets.Due ? _tasks.Where(t => t.DueDate is { } due && due <= DateOnly.FromDateTime(DateTime.Today.AddDays(14))).ToList() : _tasks;
                                @foreach (var task in tasks)
                                {
                                    <div><MudLink Href="@($"/workspaces/{task.WorkspaceId}")">@task.Title</MudLink> <MudText Typo="Typo.caption" Inline="true">@task.WorkspaceName @task.DueDate</MudText></div>
                                }
                                @if (tasks.Count == 0) { <MudText Typo="Typo.body2">@(widget == HomeWidgets.Due ? "Nothing due in the next two weeks." : "No open tasks.")</MudText> }
                                break;
                        }
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    </Authorized>
</AuthorizeView>
