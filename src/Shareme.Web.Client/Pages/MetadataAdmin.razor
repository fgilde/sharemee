@page "/admin/metadata"
@attribute [Authorize]
@using Coworkee.Client.Blazor.Api
@using Shareme.Contracts.Graph
@using Shareme.Contracts.Metadata

<PageHeader Title="Metadata" Description="Define the properties files and folders can carry. Search filters, rules, AI tagging and licensing build on them, so start here." />

<MudTabs Elevation="0" Outlined="true">
    <MudTabPanel Text="Properties">
        <div class="pa-4">
            <MudSimpleTable Dense="Density.Dense" Hover="true">
                <thead><tr><th>Key</th><th>Name</th><th>Type</th><th>@L["Choice list"]</th><th>Options</th><th></th></tr></thead>
                <tbody>
                    @foreach (var definition in _definitions)
                    {
                        <tr data-definition="@definition.Key">
                            <td>@definition.Key</td>
                            <td>@definition.Name</td>
                            <td>@definition.ValueType</td>
                            <td>@definition.ListMode</td>
                            <td>@Options(definition)</td>
                            <td style="text-align:right;white-space:nowrap">
                                <MudTooltip Text="@L["Edit"]"><MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" aria-label="Edit" OnClick="() => Edit(definition)" Disabled="definition.IsSystem" /></MudTooltip>
                                <MudTooltip Text="@L["Delete"]"><MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" aria-label="Delete" OnClick="() => RunAsync(() => Api.DeleteDefinitionAsync(definition.Id))" Disabled="definition.IsSystem" /></MudTooltip>
                            </td>
                        </tr>
                    }
                    @if (_definitions.Count == 0)
                    {
                        <tr><td colspan="6">@L["No properties yet. Create the first one below."]</td></tr>
                    }
                </tbody>
            </MudSimpleTable>

            <MudPaper Outlined="true" Class="pa-4 mt-4">
                <MudText Typo="Typo.h6">@(_editing is null ? "New property" : $"Edit {_form.Key}")</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="4"><MudTextField Margin="Density.Margin" @bind-Value="_form.Key" Label="Key" Disabled="_editing is not null" data-testid="definition-key" /></MudItem>
                    <MudItem xs="12" sm="4"><MudTextField Margin="Density.Margin" @bind-Value="_form.Name" Label="Name" data-testid="definition-name" /></MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSelect Margin="Density.Margin" Dense="Density.Dense" @bind-Value="_form.ValueType" Label="Value type" Disabled="_editing is not null">
                            @foreach (var type in PropertyValueTypes.All)
                            {
                                <MudSelectItem Value="@type">@type</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSelect Margin="Density.Margin" Dense="Density.Dense" @bind-Value="_form.ListMode" Label="List values">
                            <MudSelectItem Value="@ListModes.None">none</MudSelectItem>
                            <MudSelectItem Value="@ListModes.Single">single choice</MudSelectItem>
                            <MudSelectItem Value="@ListModes.Multi">multiple choice</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSelect Margin="Density.Margin" Dense="Density.Dense" T="Guid?" @bind-Value="_form.GroupId" Label="Group" Clearable="true">
                            @foreach (var group in _groups)
                            {
                                <MudSelectItem T="Guid?" Value="@group.Id">@group.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSelect Margin="Density.Margin" Dense="Density.Dense" T="string" Label="Applies to" MultiSelection="true" SelectedValues="_form.NodeTypeKeys" SelectedValuesChanged="v => _form.NodeTypeKeys = v.ToList()" HelperText="Empty = all types">
                            <MudSelectItem T="string" Value="@NodeTypeKeys.Folder">@L["folder"]</MudSelectItem>
                            <MudSelectItem T="string" Value="@NodeTypeKeys.Asset">@L["file"]</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6"><MudTextField Margin="Density.Margin" @bind-Value="_form.Regex" Label="@L["Allowed pattern (regular expression)"]" /></MudItem>
                    <MudItem xs="6" sm="3"><MudNumericField Margin="Density.Margin" T="decimal?" @bind-Value="_form.Min" Label="Min" /></MudItem>
                    <MudItem xs="6" sm="3"><MudNumericField Margin="Density.Margin" T="decimal?" @bind-Value="_form.Max" Label="Max" /></MudItem>
                    <MudItem xs="12">
                        <MudCheckBox Dense="Density.Dense" @bind-Value="_form.Required" Label="Required" />
                        <MudCheckBox Dense="Density.Dense" @bind-Value="_form.MultiValue" Label="Multiple values" />
                        <MudCheckBox Dense="Density.Dense" @bind-Value="_form.Localizable" Label="Translatable" />
                        <MudCheckBox Dense="Density.Dense" @bind-Value="_form.HasContext" Label="@L["Different value per audience"]" />
                        <MudCheckBox Dense="Density.Dense" @bind-Value="_form.InheritToChildren" Label="@L["Inherit to subfolders and files"]" />
                        <MudCheckBox Dense="Density.Dense" @bind-Value="_form.AllowCustomValues" Label="Allow own list values" />
                        <MudCheckBox Dense="Density.Dense" @bind-Value="_form.IgnoreOnNewVersion" Label="Do not copy to new versions" />
                        <MudCheckBox Dense="Density.Dense" @bind-Value="_form.Editable" Label="Editable" />
                        <MudCheckBox Dense="Density.Dense" @bind-Value="_form.Facet" Label="@L["Show as search filter"]" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSelect Margin="Density.Margin" Dense="Density.Dense" @bind-Value="_form.Searchable" Label="Search">
                            <MudSelectItem Value="@SearchModes.None">not searchable</MudSelectItem>
                            <MudSelectItem Value="@SearchModes.Filter">@L["as filter"]</MudSelectItem>
                            <MudSelectItem Value="@SearchModes.Fulltext">full text</MudSelectItem>
                            <MudSelectItem Value="@SearchModes.Both">@L["as filter and full text"]</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveDefinitionAsync" data-testid="save-definition">Save</MudButton>
                @if (_editing is not null)
                {
                    <MudButton OnClick="() => Edit(null)">Cancel</MudButton>
                }
            </MudPaper>

            @if (_editing is { ListMode: not ListModes.None })
            {
                <MudPaper Outlined="true" Class="pa-4 mt-4">
                    <MudText Typo="Typo.h6">List values</MudText>
                    @foreach (var value in _listValues)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudTextField @bind-Value="value.Key" Label="Key" Margin="Density.Margin" />
                            <MudTextField @bind-Value="value.Name" Label="Name" Margin="Density.Margin" />
                            <MudCheckBox Dense="Density.Dense" @bind-Value="value.IsActive" Label="Active" />
                            <MudTooltip Text="@L["Remove"]"><MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" aria-label="Remove" OnClick="() => _listValues.Remove(value)" /></MudTooltip>
                        </MudStack>
                    }
                    <MudButton OnClick="() => _listValues.Add(new ListValueRow())">Add value</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveListValuesAsync">Save list values</MudButton>
                </MudPaper>
            }
        </div>
    </MudTabPanel>
    <MudTabPanel Text="Groups">
        <div class="pa-4">
            <MudText Typo="Typo.body2" Class="mb-2">@L["Groups bundle properties under a heading in the metadata form."]</MudText>
            @foreach (var group in _groups)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudText>@group.Name (@group.Key)</MudText>
                    <MudTooltip Text="@L["Delete"]"><MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" aria-label="Delete" OnClick="() => RunAsync(() => Api.DeleteGroupAsync(group.Id))" /></MudTooltip>
                </MudStack>
            }
            <MudStack Row="true" AlignItems="AlignItems.End">
                <MudTextField Margin="Density.Margin" @bind-Value="_groupKey" Label="Key" />
                <MudTextField Margin="Density.Margin" @bind-Value="_groupName" Label="Name" />
                <MudButton OnClick="() => RunAsync(() => Api.SaveGroupAsync(null, new PropertyGroupRequest(_groupKey ?? string.Empty, _groupName ?? string.Empty, _groups.Count)))">Add</MudButton>
            </MudStack>
        </div>
    </MudTabPanel>
    <MudTabPanel Text="Languages">
        <div class="pa-4">
            <MudText Typo="Typo.body2" Class="mb-2">@L["The languages a translatable property can have values in."]</MudText>
            @foreach (var language in _languages)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudText>@language.Name (@language.Code) @(language.IsDefault ? "– default" : null)</MudText>
                    @if (!language.IsDefault)
                    {
                        <MudButton Size="Size.Small" OnClick="() => RunAsync(() => Api.SaveLanguageAsync(language with { IsDefault = true }))">Make default</MudButton>
                        <MudTooltip Text="@L["Delete"]"><MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" aria-label="Delete" OnClick="() => RunAsync(() => Api.DeleteLanguageAsync(language.Code))" /></MudTooltip>
                    }
                </MudStack>
            }
            <MudStack Row="true" AlignItems="AlignItems.End">
                <MudTextField Margin="Density.Margin" @bind-Value="_languageCode" Label="Code (e.g. de)" />
                <MudTextField Margin="Density.Margin" @bind-Value="_languageName" Label="Name" />
                <MudButton OnClick="() => RunAsync(() => Api.SaveLanguageAsync(new DataLanguageDto(_languageCode ?? string.Empty, _languageName ?? string.Empty, false)))">Add</MudButton>
            </MudStack>
        </div>
    </MudTabPanel>
    <MudTabPanel Text="@L["Audiences"]">
        <div class="pa-4">
            <MudText Typo="Typo.body2" Class="mb-2">@L["Audiences, for example markets like eu or us, let a property have a different value per audience and price lists a different price."]</MudText>
            @foreach (var context in _contexts)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudText>@context.Name (@context.Key) @(context.IsDefault ? "– default" : null)</MudText>
                    @if (!context.IsDefault)
                    {
                        <MudButton Size="Size.Small" OnClick="() => RunAsync(() => Api.SaveContextAsync(context with { IsDefault = true }))">Make default</MudButton>
                        <MudTooltip Text="@L["Delete"]"><MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" aria-label="Delete" OnClick="() => RunAsync(() => Api.DeleteContextAsync(context.Key))" /></MudTooltip>
                    }
                </MudStack>
            }
            <MudStack Row="true" AlignItems="AlignItems.End">
                <MudTextField Margin="Density.Margin" @bind-Value="_contextKey" Label="Key (e.g. eu)" />
                <MudTextField Margin="Density.Margin" @bind-Value="_contextName" Label="Name" />
                <MudButton OnClick="() => RunAsync(() => Api.SaveContextAsync(new UserContextDto(_contextKey ?? string.Empty, _contextName ?? string.Empty, false)))">Add</MudButton>
            </MudStack>
        </div>
    </MudTabPanel>
</MudTabs>
