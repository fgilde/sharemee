@page "/admin/node-types"
@attribute [Authorize]
@using Coworkee.Client.Blazor.Api
@using Shareme.Contracts.Graph

<PageHeader Title="Item types" Description="The kinds of items content can be: folders, files, pages and your own types. Properties, rules, formats and AI tagging can be limited to certain types." />

<MudSimpleTable Dense="Density.Dense" Hover="true">
    <thead><tr><th>Key</th><th>Name</th><th>@L["Based on"]</th><th>Icon</th><th></th></tr></thead>
    <tbody>
        @foreach (var type in _types)
        {
            <tr data-type="@type.Key">
                <td>@type.Key</td>
                <td>@type.Name</td>
                <td>@type.Semantic</td>
                <td>@type.Icon</td>
                <td>@(type.IsSystem ? L["built in"] : null)</td>
            </tr>
        }
        @if (_types.Count == 0)
        {
            <tr><td colspan="5">@L["No item types yet. Create your own type below."]</td></tr>
        }
    </tbody>
</MudSimpleTable>

<MudPaper Outlined="true" Class="pa-4 mt-4">
    <MudText Typo="Typo.h6">New custom type</MudText>
    <MudStack Row="true" AlignItems="AlignItems.End">
        <MudTextField Margin="Density.Margin" @bind-Value="_key" Label="Key" data-testid="type-key" />
        <MudTextField Margin="Density.Margin" @bind-Value="_name" Label="Name" data-testid="type-name" />
        <MudTextField Margin="Density.Margin" @bind-Value="_icon" Label="Icon (material name)" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateAsync" data-testid="create-type">Create</MudButton>
    </MudStack>
</MudPaper>

<MudPaper Outlined="true" Class="pa-4 mt-4">
    <MudText Typo="Typo.h6">Search index</MudText>
    <MudText Typo="Typo.body2" Class="mb-2">Rebuilds the index of this organisation's folders and assets, for example after changing which properties are searchable. Search keeps working meanwhile.</MudText>
    <MudButton Variant="Variant.Outlined" OnClick="ReindexAsync" data-testid="reindex">Rebuild index</MudButton>
    @foreach (var run in _runs)
    {
        <MudText Typo="Typo.caption" Class="d-block">@run.StartedAt.ToLocalTime().ToString("g"): @run.State, @run.Indexed indexed@(run.Failed > 0 ? $", {run.Failed} failed" : null) @run.Error</MudText>
    }
</MudPaper>
