@page "/assistant"
@attribute [Authorize]
@using Coworkee.Client.Blazor.Api
@using Coworkee.Contracts.Ai
@using Shareme.Web.Client.Assistant
@inject IAssistantApi Api
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Assistant</PageTitle>
<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Assistant</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Add" OnClick="Clear" Disabled="_busy" data-testid="new-chat">New conversation</MudButton>
</MudStack>

<MudStack Spacing="2" Class="mb-4" data-testid="conversation">
    @if (_turns.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">Ask for something, for example "Create a folder Summer 2026 in Marketing" or "Find the brochures tagged campaign".</MudText>
    }
    @foreach (var turn in _turns)
    {
        <MudPaper Class="pa-3" Elevation="0" Outlined="true" Style="@(turn.Message.Role == "user" ? "margin-left:15%" : "margin-right:15%")" data-role="@turn.Message.Role">
            <MudText Typo="Typo.caption" Color="Color.Secondary">@(turn.Message.Role == "user" ? "You" : "Assistant")</MudText>
            @* plain text only: the answer may echo content of items and must never render as markup *@
            <MudText Typo="Typo.body1" Style="white-space:pre-wrap">@turn.Message.Text</MudText>
            @if (turn.ToolCalls.Count > 0)
            {
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-2">
                    @foreach (var call in turn.ToolCalls)
                    {
                        <MudTooltip Text="@(call.Error ?? call.Input)">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(call.Succeeded ? Color.Success : Color.Error)"
                                     Icon="@(call.Succeeded ? Icons.Material.Outlined.Check : Icons.Material.Outlined.ErrorOutline)" data-tool="@call.Tool">@call.Tool</MudChip>
                        </MudTooltip>
                    }
                </MudStack>
            }
        </MudPaper>
    }
    @if (_busy)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
</MudStack>

<MudStack Row="true" AlignItems="AlignItems.End">
    <MudTextField T="string" @bind-Value="_input" Label="Message" Lines="3" Variant="Variant.Outlined" MaxLength="20000" Disabled="_busy" Class="flex-grow-1" data-testid="message" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Outlined.Send" OnClick="SendAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_input))" data-testid="send">Send</MudButton>
</MudStack>

@code {
    // the API takes at most 50 messages, 20000 characters each and 100000 in all
    private const int MaxHistory = 40;
    private const int MaxMessageLength = 20_000;
    private const int MaxHistoryLength = 90_000;

    private sealed record Turn(ChatMessageDto Message, IReadOnlyList<AiToolCallDto> ToolCalls);

    private readonly List<Turn> _turns = [];
    private readonly CancellationTokenSource _closed = new();
    private string? _input;
    private bool _busy;

    public void Dispose()
    {
        _closed.Cancel();
        _closed.Dispose();
    }

    private void Clear()
    {
        _turns.Clear();
        _input = null;
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_input))
        {
            return;
        }

        _turns.Add(new Turn(new ChatMessageDto("user", Cut(_input.Trim())), []));
        _input = null;
        _busy = true;
        try
        {
            var answer = await Api.ChatAsync(History(), _closed.Token);
            _turns.Add(new Turn(new ChatMessageDto("assistant", string.IsNullOrWhiteSpace(answer.Text) ? "(no answer)" : Cut(answer.Text)), answer.ToolCalls));
        }
        catch (OperationCanceledException) when (_closed.IsCancellationRequested)
        {
            // the page was left
        }
        catch (Exception exception)
        {
            _input = _turns[^1].Message.Text;
            _turns.RemoveAt(_turns.Count - 1);
            Snackbar.Add(exception is ApiException ? exception.Message : "The assistant did not answer in time. Try again or start a new conversation.", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>The API keeps no conversation: the newest turns that fit, starting with a question.</summary>
    private List<ChatMessageDto> History()
    {
        var history = new List<ChatMessageDto>();
        var length = 0;
        for (var i = _turns.Count - 1; i >= 0 && history.Count < MaxHistory; i--)
        {
            length += _turns[i].Message.Text.Length;
            if (length > MaxHistoryLength && history.Count > 0)
            {
                break;
            }

            history.Insert(0, _turns[i].Message);
        }

        return [.. history.SkipWhile(m => m.Role != "user")];
    }

    private static string Cut(string text) => text.Length > MaxMessageLength ? text[..MaxMessageLength] : text;
}
