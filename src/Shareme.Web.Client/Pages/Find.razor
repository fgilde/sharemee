@page "/find"
@attribute [Authorize]
@using Coworkee.Client.Blazor.Api
@using Shareme.Contracts.Knowledge
@using Shareme.Web.Client.Knowledge

<PageHeader Title="Quick search" Description="Find files, pages, news and people in one go. For filters, sorting and saved searches use File search." />
<MudTextField Margin="Density.Margin" T="string" @bind-Value="_term" Placeholder="Search files, pages, news and people" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
              OnKeyDown="KeyAsync" Immediate="true" Class="mb-4" data-testid="find-term" />

@if (_result is { } result)
{
    <MudGrid>
        <MudItem xs="12" md="8">
            <MudText Typo="Typo.h6">Content (@result.NodeTotal)</MudText>
            <NodeList Nodes="result.Nodes" Empty="@L["Nothing found. Try another or a shorter word."]" />
            @if (result.NodeTotal > result.Nodes.Count)
            {
                <MudButton Size="Size.Small" Href="@($"/search?q={Uri.EscapeDataString(Term ?? string.Empty)}")">@L["All results in File search"]</MudButton>
            }
        </MudItem>
        <MudItem xs="12" md="4">
            <MudText Typo="Typo.h6">People</MudText>
            @foreach (var person in result.People)
            {
                <div class="mb-2" data-person="@person.DisplayName">
                    <b>@person.DisplayName</b>
                    <MudText Typo="Typo.caption" Class="d-block">@person.Position @person.Department</MudText>
                    @if (IPeopleApi.MailTo(person.Email) is { } mail) { <MudLink Href="@mail" Typo="Typo.caption">@person.Email</MudLink> }
                </div>
            }
            @if (result.People.Count == 0) { <MudText Typo="Typo.body2">@L["Nobody found. Try a name, department or place."]</MudText> }
        </MudItem>
    </MudGrid>
}
