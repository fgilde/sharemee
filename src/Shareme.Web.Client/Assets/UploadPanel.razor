@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable
@inject UploadQueue Queue

<div class="relative">
    <MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="OnFilesChanged" MaximumFileCount="500" MaxFileSize="@(20L * 1024 * 1024 * 1024)" DragAndDrop="true" data-testid="upload-input">
        <CustomContent>
            <MudPaper Outlined="true" Class="pa-4 d-flex align-center justify-center mud-width-full" Style="border-style:dashed;cursor:pointer" @onclick="context.OpenFilePickerAsync">
                <MudIcon Icon="@Icons.Material.Outlined.CloudUpload" Class="mr-2" />
                <MudText>@(AssetId is null ? "Drop files here or click to upload" : "Drop a file here or click to upload a new version")</MudText>
            </MudPaper>
        </CustomContent>
    </MudFileUpload>
</div>

@if (Queue.Items.Count > 0)
{
    <MudList T="string" Dense="true" Class="mt-2" data-testid="upload-queue">
        @foreach (var item in Queue.Items)
        {
            <MudListItem T="string">
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.body2" Style="min-width:200px">@item.Name</MudText>
                    <MudProgressLinear Value="@(item.Progress * 100)" Color="@(item.State == UploadItemStates.Failed ? Color.Error : Color.Primary)"
                                       Indeterminate="@(item.State == UploadItemStates.Processing)" Style="max-width:240px" />
                    <MudText Typo="Typo.caption" data-upload-state="@item.State">@Label(item)</MudText>
                </MudStack>
            </MudListItem>
        }
    </MudList>
    <MudButton Size="Size.Small" OnClick="Queue.ClearFinished">Clear finished</MudButton>
}

@code {
    [Parameter] public Guid? FolderId { get; set; }

    [Parameter] public Guid? AssetId { get; set; }

    protected override void OnInitialized() => Queue.Changed += Refresh;

    public void Dispose() => Queue.Changed -= Refresh;

    private void Refresh() => InvokeAsync(StateHasChanged);

    private void OnFilesChanged(IReadOnlyList<IBrowserFile>? files)
    {
        if (files is { Count: > 0 })
        {
            Queue.Enqueue(files, FolderId, AssetId);
        }
    }

    private static string Label(UploadItem item) => item.State switch
    {
        UploadItemStates.Queued => "waiting",
        UploadItemStates.Uploading => $"{item.Progress:P0}",
        UploadItemStates.Processing => "processing",
        UploadItemStates.Done => "done",
        _ => item.Error ?? "failed",
    };
}
