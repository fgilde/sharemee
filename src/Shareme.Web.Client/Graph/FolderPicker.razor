@using Coworkee.Contracts
@using Shareme.Contracts.Graph
@inject ISharemeApi Api

@if (_current is not null)
{
    <MudBreadcrumbs Items="_crumbs" />
    <MudList T="Guid" Dense="true">
        @foreach (var folder in _folders)
        {
            <MudListItem T="Guid" Icon="@Icons.Material.Outlined.Folder" OnClick="() => OpenAsync(folder.Id)">@folder.Name</MudListItem>
        }
    </MudList>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => OnPicked.InvokeAsync(_current.Node.Id)" data-testid="pick-folder">Move here: @_current.Node.Name</MudButton>
}

@code {
    private NodeDetailDto? _current;
    private IReadOnlyList<NodeDto> _folders = [];
    private List<BreadcrumbItem> _crumbs = [];

    [Parameter, EditorRequired] public Guid StartId { get; set; }

    [Parameter] public EventCallback<Guid> OnPicked { get; set; }

    protected override async Task OnInitializedAsync() => await OpenAsync(StartId);

    private async Task OpenAsync(Guid id)
    {
        _current = await Api.GetNodeAsync(id);
        _crumbs = _current.Breadcrumb.Select(c => new BreadcrumbItem(c.Name, null)).ToList();
        _folders = (await Api.GetChildrenAsync(id, new PageRequest(1, 200))).Items.Where(n => n.Semantic == "folder").ToList();
    }
}
