@using Coworkee.Client.Blazor.Api
@using Shareme.Contracts.Workspaces

<RealtimeSubscription @key="NodeId" Topic="@($"children:{NodeId}")" OnEvent="_ => ReloadSoonAsync()" />
<MudStack Spacing="2" data-testid="comments">
    @foreach (var comment in _comments)
    {
        <MudPaper Outlined="true" Class="pa-2" data-comment="@comment.Id">
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.subtitle2">@comment.AuthorName</MudText>
                <MudText Typo="Typo.caption">@comment.CreatedAt.ToLocalTime().ToString("g")@(comment.EditedAt is null ? null : " · edited")</MudText>
                <MudSpacer />
                @if (comment.CanEdit)
                {
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" aria-label="Delete comment" OnClick="() => RunAsync(() => Api.DeleteCommentAsync(comment.Id))" />
                }
            </MudStack>
            @* plain text, no markup from users in the page *@
            <MudText Typo="Typo.body2" Style="white-space:pre-wrap">@comment.Text</MudText>
            @if (comment.MentionIds.Count > 0)
            {
                <MudText Typo="Typo.caption">@string.Join(", ", comment.MentionIds.Select(id => "@" + MemberName(id)))</MudText>
            }
        </MudPaper>
    }
    @if (_comments.Count == 0)
    {
        <MudText Typo="Typo.body2">No comments yet.</MudText>
    }
    <MudTextField Margin="Density.Margin" @bind-Value="_text" Label="Write a comment" Lines="3" Immediate="true" data-testid="comment-text" />
    @if (Members.Count > 0)
    {
        <MudSelect Margin="Density.Margin" Dense="Density.Dense" T="Guid" @bind-SelectedValues="_mentions" MultiSelection="true" Label="Mention" ToStringFunc="@(id => MemberName(id))" Clearable="true">
            @foreach (var member in Members)
            {
                <MudSelectItem T="Guid" Value="@member.UserId">@(string.IsNullOrWhiteSpace(member.Name) ? member.Email : member.Name)</MudSelectItem>
            }
        </MudSelect>
    }
    <div><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="string.IsNullOrWhiteSpace(_text)" OnClick="AddAsync" data-testid="add-comment">Comment</MudButton></div>
</MudStack>
